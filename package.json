{
  "name": "@martin/dsh-voice",
  "version": "1.0.0",
  "description": "Martin's self-contained two-way voice plugin for the DSH web app: unified voice composer in, per-message speaker buttons and auto-read out (own TTS server), plus the speech-to-text wiring. Forked from @deepseek-ai/dsh-experimental-client-ui-voice-input 0.1.7-rc.2 and maintained here as a standalone plugin.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "tts",
    "bin",
    "ref_voices"
  ],
  "scripts": {
    "bundle": "tsdown",
    "test": "vitest run"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.0.1-rc.1",
    "@deepseek-ai/dsh-experimental-api-speech-to-text": "link:../../deepseek-harness/packages/experimental/api-speech-to-text",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.32.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
